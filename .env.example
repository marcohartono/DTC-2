# Server-only secrets (never exposed to the browser)
OPENAI_API_KEY=          # used only by the analyze-tdr-photo Edge Function; set it in Supabase Edge Function secrets too
SUPABASE_KEY=            # service/secret key — server use only, never client-side

# Client-visible (Vite exposes only VITE_-prefixed vars)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=  # anon/publishable key — safe in the browser (protected by RLS)
VITE_MAPBOX_TOKEN=       # Mapbox public token (pk....) for the geofence map editor
